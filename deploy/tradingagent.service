[Unit]
Description=TradingAgent dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=trader
WorkingDirectory=/opt/tradingagent
ExecStart=/opt/tradingagent/.venv/bin/python -m web.serve
Restart=on-failure
RestartSec=5
# The app reads its settings (password hash, Zerodha keys) from /opt/tradingagent/.env itself.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/tradingagent

[Install]
WantedBy=multi-user.target
